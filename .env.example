# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Model routing (ADR-012 A3/A4). Override to experiment; record changes in DECISIONS.md.
EXTRACT_MODEL=gemini-flash-lite-latest
INTERPRET_MODEL=gemini-flash-latest
JUDGE_MODEL=openai/gpt-oss-120b
INTERPRET_SAMPLES=3
