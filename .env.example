# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Model routing (ADR-013 supersedes ADR-012 A3; A4 judge unchanged). Override to experiment; record changes in DECISIONS.md.
EXTRACT_MODEL=claude-haiku-4-5-20251001
INTERPRET_MODEL=claude-sonnet-5
JUDGE_MODEL=openai/gpt-oss-120b
INTERPRET_SAMPLES=3
