# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Model routing (ADR-013, ADR-017: extraction on Sonnet 5; A4 judge unchanged). Override to experiment; record changes in DECISIONS.md.
EXTRACT_MODEL=claude-sonnet-5
INTERPRET_MODEL=claude-sonnet-5
JUDGE_MODEL=openai/gpt-oss-120b
INTERPRET_SAMPLES=3
